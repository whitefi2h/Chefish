{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chefish",
  "version": "2.3.3",
  "identifier": "com.chefish.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chefish 路 鎴戠殑鍘ㄦ埧",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMTBBRUY1NTZFRDA4MTMKUldRVENPMVc5YTRRL2xWdlBXWmtMalBBRFBXdVNJZE01dFVFYk1MWGNnd0RLTDhyVXNSbVZ1V2sK",
      "endpoints": [
        "https://github.com/whitefi2h/Chefish/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
